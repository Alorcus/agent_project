# Copy to `.env` and adjust. All variables are optional; see the
# Configuration table in README.md for defaults and meaning.

# AGENTCHAT_BACKEND=local
# AGENTCHAT_MODEL_ROOT=/sc/projects/sci-lippert/intelligent-agents/model_checkpoints
# AGENTCHAT_MODEL=phi-4-mini
# AGENTCHAT_MAX_CONTEXT=8192
# AGENTCHAT_DATA_DIR=./data
# AGENTCHAT_CORPUS_DIR=./corpus
# AGENTCHAT_SIMULATE_FAILURE=0

# Adaptive fact retrieval (see README "Recalling earlier conversations")
# AGENTCHAT_RECALL_FACTS=1
# AGENTCHAT_EMBED_MODEL=all-MiniLM-L6-v2
# AGENTCHAT_EMBED_MODEL_PATH=
# AGENTCHAT_RECALL_ROUNDS=3
# AGENTCHAT_RECALL_REWRITES=3
# AGENTCHAT_RECALL_HITS=10
# AGENTCHAT_RECALL_SEEDS=2
# AGENTCHAT_RECALL_MIN_SCORE=0.25
# AGENTCHAT_RECALL_DIGEST_FACTS=12
# AGENTCHAT_RECALL_TIMEOUT=120.0
